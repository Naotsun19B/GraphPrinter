// Canonical build / test / verify entry points for this project.
// These are the SAME commands Claude Code and Codex run, so Ctrl+Shift+B and an
// agent command line give identical results. Do not add a second build path.
// UnrealBuildTool does NOT write this file, so custom tasks are safe here.
// Generated by unreal-toolbox setup_vscode.py; re-run it to refresh.
{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}"
	},
	"inputs": [
		{
			"id": "engineVersion",
			"type": "pickString",
			"description": "Engine version to build against",
			"options": [
				"4.27",
				"5.0",
				"5.1",
				"5.2",
				"5.3",
				"5.4",
				"5.5",
				"5.6",
				"5.7",
				"5.8"
			],
			"default": "4.27"
		},
		{
			"id": "testPattern",
			"type": "promptString",
			"description": "Automation test name pattern (prefix match)",
			"default": "GraphPrinterPlugin"
		},
		{
			"id": "tailLines",
			"type": "promptString",
			"description": "How many trailing lines of the newest log to show",
			"default": "300"
		}
	],
	"tasks": [
		{
			"label": "UE: Build Editor",
			"detail": "Build the editor target via unreal-toolbox build.py (engine comes from .claude/ue-project-cache.json).",
			"type": "process",
			"command": "python",
			"args": [
				"${userHome}/.claude/local-marketplace/plugins/unreal-toolbox/scripts/build.py"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "UE: Build Editor (Select Engine)",
			"detail": "Same as 'UE: Build Editor' but targets a chosen engine version. UHT generated code is cleaned automatically when the engine changes.",
			"type": "process",
			"command": "python",
			"args": [
				"${userHome}/.claude/local-marketplace/plugins/unreal-toolbox/scripts/build.py",
				"--engine-version",
				"${input:engineVersion}"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "UE: Launch Editor",
			"detail": "Start the Unreal Editor on this project without building. Runs detached, so the task finishes immediately.",
			"type": "shell",
			"command": "$cache = Get-Content -Raw -Encoding UTF8 '.claude/ue-project-cache.json' | ConvertFrom-Json; $binaries = Split-Path -Parent (Split-Path -Parent (Split-Path -Parent $cache.ubt_path)); $editor = Join-Path $binaries 'Win64/UnrealEditor.exe'; if (-not (Test-Path $editor)) { Write-Error \"Editor not found: $editor\"; exit 1 }; Write-Host \"Launching $editor\"; Start-Process -FilePath $editor -ArgumentList \"`\"$($cache.uproject_path)`\"\"",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "UE: Build and Launch Editor",
			"detail": "Build the editor target, then start the Unreal Editor on this project.",
			"dependsOrder": "sequence",
			"dependsOn": [
				"UE: Build Editor",
				"UE: Launch Editor"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "UE: Run Automation Tests",
			"detail": "Run automation tests matching a name pattern and write a report under Saved/Automation.",
			"type": "process",
			"command": "python",
			"args": [
				"${userHome}/.claude/local-marketplace/plugins/unreal-toolbox/scripts/automation_test.py",
				"--test",
				"${input:testPattern}"
			],
			"problemMatcher": [],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "UE: Regenerate Project Files (VS Code)",
			"detail": "Regenerate .vscode/c_cpp_properties.json and compileCommands. Run this after adding, renaming or deleting source files, or after changing Build.cs / Target.cs / uplugin / uproject.",
			"type": "shell",
			"command": "$cache = Get-Content -Raw -Encoding UTF8 '.claude/ue-project-cache.json' | ConvertFrom-Json; & $cache.ubt_path -projectfiles \"-project=$($cache.uproject_path)\" -game -rocket -progress -VSCode",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "UE: Show Log (tail)",
			"detail": "Print the tail of the newest Saved/Logs/*.log. Works even though Saved is hidden from the Explorer.",
			"type": "shell",
			"command": "$log = Get-ChildItem 'Saved/Logs/*.log' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if (-not $log) { Write-Error 'No log file found under Saved/Logs.'; exit 1 }; Write-Host \"==> $($log.FullName)\"; Get-Content -Encoding UTF8 $log.FullName -Tail ${input:tailLines}",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "Git: Check Diff",
			"detail": "git status --short, git diff --check and git diff --stat. Part of 'UE: Verify'.",
			"type": "shell",
			"command": "git status --short; git diff --check; if ($LASTEXITCODE -ne 0) { Write-Error 'git diff --check reported whitespace errors.'; exit 1 }; git diff --stat",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "UE: Verify",
			"detail": "Build -> Automation Tests -> Git diff check. Stops at the first failing step.",
			"dependsOrder": "sequence",
			"dependsOn": [
				"UE: Build Editor",
				"UE: Run Automation Tests",
				"Git: Check Diff"
			],
			"problemMatcher": [],
			"group": "build"
		}
	]
}
